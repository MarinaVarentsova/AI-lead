# ИНОБР v2 — структурный этап, существующий backend
# Передайте переменные процессу; автоматическая загрузка .env пока не добавлена.
# Не коммитьте реальные секреты.

# Существующее подключение PostgreSQL. Перенос в Selectel ещё не выполнен.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backend port. Для frontend dev задайте отдельный PORT, например 3000.
PORT=8080
LOG_LEVEL=info

# Frontend dev proxy; production использует reverse proxy /api.
API_TARGET=http://localhost:8080
BASE_PATH=/

# Legacy AI: сохранён до следующего этапа, Yandex пока не подключён.
OPENAI_API_KEY=your_openai_api_key_here
KNOWLEDGE_BASE_SOURCE=file

# Новый provider layer; /api/diagnose пока использует legacy AI.
AI_PROVIDER=yandex
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_API_KEY=
# Полный URI модели, включая идентификатор каталога: gpt://<folder-id>/<model>/<version>
YANDEX_AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000

# ИНОБР v2 — структурный этап, существующий backend
# Передайте переменные процессу; автоматическая загрузка .env пока не добавлена.
# Не коммитьте реальные секреты.

# Существующее подключение PostgreSQL. Перенос в Selectel ещё не выполнен.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backend port. Для frontend dev задайте отдельный PORT, например 3000.
PORT=8080
LOG_LEVEL=info

# Frontend dev proxy; production использует reverse proxy /api.
API_TARGET=http://localhost:8080
BASE_PATH=/

KNOWLEDGE_BASE_SOURCE=file

# Yandex AI provider for diagnostic, consultation and web-result synthesis.
AI_PROVIDER=yandex
YANDEX_AI_API_KEY=
# Полный URI модели, включая идентификатор каталога: gpt://<folder-id>/<model>/<version>
YANDEX_AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000

# Professional web research. YANDEX_AI_API_KEY/YANDEX_AI_MODEL folder are reused when that key has
# search-api.webSearch.user; otherwise provide a dedicated key/folder pair.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SEARCH_TIMEOUT_MS=8000

# Internal tester: backend runtime only, never VITE_*.
INTERNAL_TESTER_ENABLED=false
INTERNAL_TESTER_TOKEN=

# Best-effort Telegram notification after a confirmed GetCourse manager-form submit.
# Keep TELEGRAM_BOT_TOKEN secret. Production group chat ID is safe to configure here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5538881072
